infra_state_backend = "local"
infra_state_config  = { path = "../infra/terraform.tfstate" }

namespaces         = ["tech-challenge", "observability"]
enable_demo        = true
demo_namespace     = "tech-challenge"
demo_ingress_cidrs = ["203.0.113.10/32"] # Substitua pelo IP público de saída do operador.

